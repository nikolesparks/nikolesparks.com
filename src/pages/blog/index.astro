---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { blogCategories } from '../../content/config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.slug !== featured?.slug);
---

<Layout
  title="Blog | Notes on the Work — Nikole Sparks, AMFT"
  description="Reflections on anxiety, relationships, and the quieter work of knowing yourself — from a depth-oriented, psychodynamic therapist in Newport Beach & Fullerton, CA."
  active="/blog/"
  path="/blog/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="col">
      <p class="eyebrow">Field notes</p>
      <h1>Things worth <em>slowing down for.</em></h1>
      <p>
        Writing on anxiety, relationships, faith, and the ongoing work of understanding yourself.
      </p>
    </div>
    <svg class="hero-figure" viewBox="0 0 420 420" fill="none" role="img" aria-label="A cluster of overlapping circles meeting at a single point, suggesting distinct threads of a life converging">
      <circle cx="210.001" cy="77.4468" r="76.6968" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="210.001" cy="342.553" r="76.6968" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="77.4468" cy="77.4468" r="76.6968" transform="matrix(-1 0 0 1 420 134.042)" fill="url(#paint0_linear_91_524)" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="77.4468" cy="77.4468" r="76.6968" transform="matrix(-1 0 0 1 382.766 38.7236)" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="114.681" cy="303.83" r="76.6968" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="77.4468" cy="77.4468" r="76.6968" transform="matrix(-1 0 0 1 382.766 226.383)" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="77.4468" cy="211.489" r="76.6968" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="114.681" cy="116.17" r="76.6968" fill="url(#paint1_linear_91_524)" stroke="#3B63C4" stroke-width="1.15"/>
      <circle cx="210" cy="210" r="16" fill="#C7D64F"/>
      <defs>
        <linearGradient id="paint0_linear_91_524" x1="151.17" y1="77.4468" x2="17.8723" y2="77.4468" gradientUnits="userSpaceOnUse">
          <stop stop-color="#C7D64F"/>
          <stop offset="1" stop-color="#C7D64F" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="paint1_linear_91_524" x1="188.405" y1="116.17" x2="55.1067" y2="116.17" gradientUnits="userSpaceOnUse">
          <stop stop-color="#C7D64F"/>
          <stop offset="1" stop-color="#C7D64F" stop-opacity="0"/>
        </linearGradient>
      </defs>
    </svg>
  </section>

  {
    featured && (
      <>
        <!-- Category filter -->
        <section class="section tight" style="padding-bottom:0">
          <div class="blog-filters" data-blog-filters>
            <button type="button" class="blog-filter active" data-filter="all">All posts</button>
            {blogCategories.map((c) => (
              <button type="button" class="blog-filter" data-filter={c}>{c}</button>
            ))}
          </div>
        </section>

        <!-- Featured post -->
        <section class="section tight">
          <a class="blog-featured" href={`/blog/${featured.slug}/`} data-category={featured.data.category}>
            <div class="media">
              <div class="placeholder">Featured post image</div>
            </div>
            <div class="content">
              <div class="meta">Featured · {featured.data.category}</div>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.excerpt}</p>
              <span class="more">Read the post <span class="arw">→</span></span>
            </div>
          </a>
        </section>
      </>
    )
  }

  <!-- Post grid -->
  <section class="section">
    <p class="eyebrow" style="margin-bottom:32px">Recent posts</p>
    <div class="blog-grid" data-blog-grid>
      {rest.map((post) => <BlogCard entry={post} />)}
    </div>
    {
      rest.length === 0 && (
        <p class="body">More posts are on the way — check back soon.</p>
      )
    }
  </section>
</Layout>

<script>
  const filters = document.querySelector('[data-blog-filters]');
  const grid = document.querySelector('[data-blog-grid]');
  const featured = document.querySelector('.blog-featured');

  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;

    filters.querySelectorAll('[data-filter]').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');

    const filter = btn.dataset.filter;
    const cards = grid?.querySelectorAll<HTMLElement>('[data-category]') ?? [];
    cards.forEach((card) => {
      card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
    });

    if (featured instanceof HTMLElement) {
      const show = filter === 'all' || featured.dataset.category === filter;
      featured.closest('section')!.style.display = show ? '' : 'none';
    }
  });
</script>
