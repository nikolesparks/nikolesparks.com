---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import Glyph from '../components/Glyph.astro';
import Illustration from '../components/Illustration.astro';
import NextSteps from '../components/NextSteps.astro';
import { site } from '../data/site';

// One shared, unique glyph for every degree — a line-art graduation cap.
// Deliberately outside the circle/ellipse motif used for therapy concepts.
const eduIcon = `<path d="M24 10 L43 18 L24 26 L5 18 Z" stroke="#3B63C4" stroke-width="1" stroke-linejoin="round"/><path d="M14 21.4 V29 Q24 34.5 34 29 V21.4" stroke="#3B63C4" stroke-width="1"/><line x1="43" y1="18" x2="43" y2="31" stroke="#3B63C4" stroke-width="1"/><circle cx="43" cy="32.5" r="2" fill="#C7D64F"/><circle cx="24" cy="18" r="1.6" fill="#3B63C4"/>`;

const education = [
  { degree: 'Certificate in Psychoanalytic Psychotherapy', school: 'Newport Psychoanalytic Institute', status: 'In-process' },
  { degree: 'M.S. Marriage &amp; Family Therapy', school: 'Fuller Graduate School' },
  { degree: 'M.A. Spiritual Formation &amp; Soul Care', school: 'Talbot School of Theology' },
  { degree: 'B.F.A. Design', school: 'Biola University' },
];

const hereBecause = [
  'Your relationships keep hitting the same walls, and you can’t figure out why',
  'It’s difficult to connect to or express yourself, your needs, or what you really want',
  'You’re tired of feeling not good enough, no matter what you achieve',
  'Anxiety is eating up your peace of mind, even when everything looks “fine” on paper',
  'You’re a creative facing burnout, cynicism, or feeling lost about your direction',
  'You and your partner are speaking different languages, or preparing for marriage and want to start well',
];

const details = [
  { label: 'Fees', big: '45 mins · $175', copy: 'Standard individual session for ongoing treatment, typically weekly. A limited number of sliding-scale spots are available — please don’t hesitate to ask.' },
  { label: 'Insurance', big: 'Private pay', copy: 'If your insurance has out-of-network coverage, I can provide a superbill for out-of-pocket reimbursement.' },
  { label: 'Location', big: 'In-person &amp; online', copy: 'Offices in Newport Beach and Fullerton, or virtually anywhere in California.' },
];

const gettingStarted = ['Discuss what brings you to therapy', 'Talk about how I might help', 'Answer any questions you have', 'See if we’re a good fit'];
---

<Layout
  title="Nikole Sparks, AMFT — Newport Beach & Fullerton Therapist"
  description="Meet Nikole Sparks, AMFT — a Newport Beach & Fullerton therapist practicing depth-oriented, attachment-based therapy."
  active="/about/"
  path="/about/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="col">
      <p class="eyebrow">Meet Nikole Sparks, AMFT</p>
      <h1>You don’t have to figure it out <em>alone.</em></h1>
      <p>
        There is much more to you than you may realize, and being human is both beautiful and
        messy. I’m here to listen with you as you
        move toward living a life with more meaning and connection.
      </p>
      <a class="cta" href="/contact/">Schedule a free consultation <span class="arw">→</span></a>
    </div>
    <Portrait
      src="/nikole_sparks-mft-website.jpg"
      alt="Nikole Sparks"
      placeholder="Nikole — portrait"
      tall
      duotone={false}
      caption={`${site.supervisor}<br />CA AMFT 150080`}
      class="hero-portrait"
    />
  </section>

  <!-- Story -->
  <section class="section split c-narrow-wide">
    <div class="col gap-20">
      <p class="eyebrow">About Nikole</p>
      <h2 class="h2-serif">Hi, I’m <em>Nikole.</em></h2>
      <Illustration name="creativity-full" size="260px" color="var(--blue)" class="hero-figure mt-16" />
    </div>
    <div class="prose prose-15">
      <p>I’m an Associate Marriage and Family Therapist specializing in depth-oriented, attachment-based therapy in Orange County. I come to therapy by way of a career as a designer. I’ve spent 15+ years helping people uncover their unique point of view and helping them turn it into a tangible expression. My background in design has shown me that therapy is its own creative process: an invitation to slow down, listen deeply to what has shaped you, and make space for what wants to emerge.</p>
      <p>My practice is grounded in psychodynamic therapy, an <a href="https://pubmed.ncbi.nlm.nih.gov/20141265/" style="color:var(--blue); border-bottom:1px solid var(--blue)">evidence-based approach</a> that helps us explore the emotional and relational patterns that shape and guide our lives. Together, we’ll trace these patterns with care, honoring where they come from while creating space for new possibilities.</p>
      <p>I work with people who want to meaningfully understand their inner emotional life, why they feel stuck, or why certain feelings and relational patterns keep recurring. I particularly enjoy working with those navigating the complicated aspects of connection, those who struggle with self-expression, and those navigating the intersection of mental health and spirituality, whether integrating faith into the healing process or untangling pain connected to a spiritual background.</p>
      <p>You can read more about <a href="/approach/" style="color:var(--blue); border-bottom:1px solid var(--blue)">my approach</a>, explore <a href="/services/premarital-counseling/" style="color:var(--blue); border-bottom:1px solid var(--blue)">premarital counseling</a>, or find answers in the <a href="/faqs/" style="color:var(--blue); border-bottom:1px solid var(--blue)">common questions</a>.</p>
    </div>
  </section>

  <!-- Education -->
  <section class="section" style="padding-top:0">
    <h2 class="eyebrow" style="margin-bottom:16px">Education</h2>
    <div class="ruled-grid cols-2 feature">
      {
        education.map((e) => (
          <div class="ruled-cell">
            <svg viewBox="0 0 48 48" width="36" height="36" fill="none" aria-hidden="true" set:html={eduIcon} />
            <span style="font-size:17px; line-height:1.5">
              <span set:html={e.degree} />
              {e.status && <span class="label" style="color:var(--blue); margin-left:8px">{e.status}</span>}
              <br />
              <span class="label" style="color:var(--ink-65); text-transform:none">{e.school}</span>
            </span>
          </div>
        ))
      }
    </div>
    <p style="font-size:14px; color:var(--ink-65); margin:24px 0 0">Nikole Sparks is an Associate Marriage and Family Therapist (AMFT 150080) based in Newport Beach and Fullerton, California.</p>
  </section>

  <!-- Quote -->
  <section class="quote-block">
    <img src="/quote.svg" alt="" class="hero-figure" width="270" height="229" />
    <div class="col gap-28">
      <blockquote>“Not until we are lost do we begin to <em>understand</em> ourselves.”</blockquote>
      <cite>Henry David Thoreau</cite>
    </div>
  </section>

  <!-- You might be here because -->
  <section class="section">
    <div class="section-heading">
      <div class="stack">
        <h2 class="h2-serif" style="max-width:720px">
          A place to pause, reflect, and <em>find a new way forward.</em>
        </h2>
      </div>
    </div>
    <p class="eyebrow" style="margin-bottom:20px">You might be here because</p>
    <div class="ruled-grid cols-2">
      {
        hereBecause.map((item, i) => (
          <div class="ruled-cell">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="copy">{item}</span>
          </div>
        ))
      }
    </div>
    <div class="card-row" style="margin-top:48px">
      <a class="service-card primary" href="/services/individual-therapy/"><span>Individual therapy</span><span class="arw" aria-hidden="true">→</span></a>
      <a class="service-card secondary" href="/services/couples-therapy/"><span>Couples therapy</span><span class="arw" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Helpful to know -->
  <section class="section sage on-color relative overflow-clip">
    <Glyph name="radiate" class="decor" />
    <div class="stack gap-20" style="margin-bottom:56px; position:relative">
      <p class="eyebrow on-color">Helpful to know</p>
      <h2 class="h2-serif">The practical details</h2>
    </div>
    <div class="detail-cards">
      {
        details.map((d) => (
          <div class="detail-card">
            <div class="label">{d.label}</div>
            <div class="big" set:html={d.big} />
            <p>{d.copy}</p>
          </div>
        ))
      }
    </div>
  </section>

  <NextSteps
    heading="Get started with a <em>15-minute conversation.</em>"
    copy="Starting therapy is vulnerable, and finding the right therapist matters. The free consultation is a low-pressure way to ask questions and get a feel for how I work."
    steps={gettingStarted}
  />
</Layout>

<style>
  /* The hero frame crops ~40px top & bottom; shift the crop toward the top so
     the top of the head isn't clipped. */
  :global(.hero-portrait .frame img) {
    object-position: center 20%;
  }
</style>
