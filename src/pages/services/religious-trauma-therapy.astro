---
import Layout from '../../layouts/Layout.astro';
import Ticker from '../../components/Ticker.astro';
import Portrait from '../../components/Portrait.astro';
import Illustration from '../../components/Illustration.astro';
import Faq from '../../components/Faq.astro';
import NextSteps from '../../components/NextSteps.astro';
import { religiousTraumaTherapyService, faqPage } from '../../data/schema';

const tickerItems = ['Deconstruction', 'Leaving the Church', 'Purity Culture', 'Religious Guilt', 'Spiritual Grief', 'Doubt', 'Ministry'];

const whoThisIsFor = [
  {
    title: 'You are still in it',
    copy: 'You have not left. You may not want to. And something is wrong in a way you cannot name to anyone there. There is a tightness you feel on Sunday mornings you cannot trace to anything. There is a version of God you carry who is mostly disappointed in you, and he sounds like someone specific. There are things you were taught about your body, your anger, or your worth that do not hold up anymore, and no one around you seems to be asking about it. You have wondered whether a therapist would understand any of this, or would quietly file your faith under the problem.',
  },
  {
    title: 'You left, and it did not leave',
    copy: 'You are out. It has been months or years. On paper you have moved on, and by most measures your life works. And it still runs underneath things. The guilt shows up on schedule with no doctrine attached to it. You flinch at certain language. You are grieving people who are still alive, or a community that felt like home, or a version of God you cannot get back and did not expect to miss. Sometimes you are angry in a way that feels out of proportion, and sometimes you feel nothing at all about something that shaped your entire childhood.',
  },
];

const relatedReading = [
  { title: 'When you still believe and something still hurts', href: '/blog/when-you-still-believe-and-something-still-hurts/' },
  { title: 'How a religious childhood shapes adult anxiety', href: '/blog/religious-childhood-adult-anxiety/' },
  { title: 'Doubt is not the same as leaving', href: '/blog/doubt-is-not-the-same-as-leaving/' },
  { title: 'The question nobody asks out loud', href: '/blog/the-question-nobody-asks-out-loud/' },
];

const faqs = [
  {
    q: 'Will you try to talk me out of my faith, or back into it?',
    a: ['Neither. I do not have an outcome I am steering you toward. My work is to help you understand what your religious history did to you and what it is still doing, and to give you room to reach your own conclusions about what you want to keep.'],
  },
  {
    q: 'Is religious trauma a real thing?',
    a: ['Religious trauma is not a formal diagnosis in the DSM. That does not mean the experience is not real or that it does not have lasting effects. What people describe under that name is usually a mix of things clinicians do recognize: early relational injury, chronic shame, anxiety tied to authority and surveillance, complicated grief, and identity that had to be built around what was permitted. We work with what is actually there rather than with the label.'],
  },
  {
    q: 'I am still going to church and things are mostly fine. Is that enough of a reason to come in?',
    a: ['Yes. Most of the people I see are functioning well by any external measure. You do not need a crisis or a dramatic story to justify looking at this. Persistent unease that you cannot explain is a good enough reason.'],
  },
  {
    q: 'I left years ago. Why is it still affecting me?',
    a: ['Because what you left was not only a set of beliefs. It was the framework your earliest ideas about love, safety, authority, and your own worth were built inside. Leaving changes your position on the beliefs. It does not automatically dismantle the structure they were attached to, which is why the guilt, the flinching, and the grief often outlast the belief itself by years.'],
  },
  {
    q: 'Do you work with pastors, ministry staff, and people in vocational ministry?',
    a: ['Yes. When your work, your faith, your social world, and your income all sit in the same place, there is often nowhere safe to say the true thing. Therapy can be that place. Sessions are confidential and are not shared with your church, your board, or your denomination.'],
  },
  {
    q: 'Can we do this over telehealth?',
    a: ['Yes. I see clients in person in Newport Beach and Fullerton, and by telehealth anywhere in California. Telehealth is often the better fit for this particular work, especially if you live in a small faith community and privacy matters to you.'],
  },
  {
    q: 'Do you take insurance?',
    a: ['I am a private-pay practice. Many clients use out-of-network benefits through a PPO plan, and I provide a monthly superbill you can submit for reimbursement. I also accept HSA and FSA cards. You can read more on the <a href="/faqs/">FAQs page</a>.'],
  },
];
---

<Layout
  title="Religious Trauma Therapy | Newport Beach, CA"
  description="Depth therapy for religious trauma, deconstruction, and a religious history that has not stayed in the past. Newport Beach, Fullerton, and telehealth across California."
  active="/services/"
  path="/services/religious-trauma-therapy/"
  schema={[
    religiousTraumaTherapyService,
    faqPage(faqs, {
      id: 'https://nikolesparks.com/services/religious-trauma-therapy#faq',
      url: 'https://nikolesparks.com/services/religious-trauma-therapy',
    }),
  ]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="col">
      <p class="eyebrow"><a href="/services/">Services</a> / Religious trauma</p>
      <h1>When faith and pain have become <em>difficult to separate.</em></h1>
      <p>
        Something you were taught, asked to carry, or made to believe about yourself still has a
        hold on you. It may be shame that comes up when you disappoint someone, anxiety around
        making your own choices, difficulty trusting your instincts, or a sense you never quite
        measure up. You may still hold your faith close. You may have stepped away. Whatever your
        relationship to faith looks like, your experience is welcome here.
      </p>
      <a class="cta" href="/contact/">Schedule a free consultation <span class="arw">→</span></a>
    </div>
    <!-- PLACEHOLDER hero illustration: swap for the custom SVG when provided. -->
    <Illustration name="perspective-full" size="clamp(380px, 44vw, 520px)" color="var(--blue)" class="hero-figure" />
  </section>

  <Ticker items={tickerItems} label="What we work with" />

  <!-- The premise -->
  <section class="section split c-wide-narrow">
    <div class="col gap-28">
      <p class="eyebrow">The premise</p>
      <h2 class="h2-serif h2-lg">The past does not stay in the past simply because you have <em>moved on.</em></h2>
      <p class="body">Most people who bring this into therapy have already tried to sort it out on their own, usually for years. They have read the books. They have had the late conversations with a friend. They have prayed about it, or stopped praying about it, and neither one settled it. You may have changed your mind about what you believe, moved away from the people or places that hurt you, or built a life that looks very different from the one you grew up in. Yet certain moments may still bring a familiar fear, shame, or sense of being watched. You may find yourself reacting to authority, conflict, desire, or disappointment in ways that feel larger than the present moment.</p>
      <p class="body">This is not a sign that you have failed to move on. It reflects how deeply formative early religious experiences can be, especially when they were tied to family, belonging, love, safety, or the fear of losing them.</p>
      <p class="body">Therapy can offer a place to look at these experiences without pressure to preserve, reject, explain, or resolve them. Rather than asking you to take a position, we work to understand what these experiences asked of you, what they cost, and how they may still be shaping your relationships, choices, and life now.</p>
    </div>
    <Illustration name="transformation-full" size="clamp(300px, 32vw, 420px)" color="var(--blue)" class="hero-figure" />
  </section>

  <!-- Who this is for -->
  <section class="section">
    <div class="stack gap-20" style="margin-bottom:48px">
      <p class="eyebrow">Who I work with</p>
      <h2 class="h2-serif" style="max-width:760px">Two people usually find this page. <em>Both belong here.</em></h2>
    </div>
    <div class="process-grid cols-2">
      {whoThisIsFor.map((c, i) => (
        <div class="process-card" style="border-top-color:var(--ink-30)">
          <span class="num" style="color:var(--blue)">{String(i + 1).padStart(2, '0')}</span>
          <div class="title">{c.title}</div>
          <p style="color:var(--ink-85)">{c.copy}</p>
        </div>
      ))}
    </div>
    <p class="body" style="max-width:640px; margin-top:36px; color:var(--ink-75)">You do not have to know which one you are before we start. Many people are both, on different days.</p>
  </section>

  <!-- What the work looks like -->
  <section class="section blue on-color split c-narrow-wide">
    <div class="col gap-20">
      <p class="eyebrow on-color">The work</p>
      <h2 class="h2-serif">We start with what it did to you. <em>Not with whether it was true.</em></h2>
    </div>
    <div class="prose">
      <p class="body">I am not going to argue theology with you, in either direction. That is not what therapy is for, and honestly it is not the part that is stuck.</p>
      <p class="body">What we do instead is go slowly through what actually happened. Not the doctrine as it was stated, but the doctrine as you received it, at seven, at fourteen, at twenty-two, in a specific house with specific people who had their own reasons for what they taught you. We look at what you had to become in order to be acceptable there. We look at what you had to put away. We pay attention to what comes up in the room when we get near certain material, because the body usually knows before the sentence finishes.</p>
      <p class="body">Depth-oriented work means we are not only cataloguing the beliefs. We are looking at the shape they left. Often what a person calls a crisis of faith turns out to also be a question about authority, or worth, or whether love has conditions, and those questions were never confined to church. They show up in your marriage, your work, your relationship to your own wanting.</p>
      <p class="body">Some people come through this with their faith intact and different. Some come through it without it. Some stay unresolved for a long time and find that the unresolvedness is livable in a way it was not before. I do not have a preferred ending for you, and I would not trust myself to hold this work if I did.</p>
      <p class="body">This is open-ended weekly work. Read more about <a href="/approach/" style="color:var(--cream); border-bottom:1px solid var(--cream-35)">how I work</a> if you want a fuller sense of the process.</p>
    </div>
  </section>

  <!-- Training and background -->
  <section class="section split c-media">
    <Portrait src="/nikole_sparks-mft-website.jpg" alt="Nikole Sparks" placeholder="Nikole — candid photo" />
    <div class="col">
      <p class="eyebrow">Background</p>
      <h2 class="serif h2-lg">Why I can hold <em class="accent">both sides of this.</em></h2>
      <p class="body">Before I trained as a therapist, I spent years inside the study of formation and faith. I hold an M.A. in Spiritual Formation and Soul Care from Talbot School of Theology, which means the theological material is not foreign to me and you will not spend your sessions translating. I am also in postgraduate psychoanalytic training at the Newport Psychoanalytic Institute, which is where the depth part comes from.</p>
      <p class="body">That combination is the reason I do not have to choose a side. A therapist who only knows the clinical literature can hear religious trauma and miss what the faith was actually giving you. A counselor who only knows the theology can hear your doubt and reach for reassurance. Neither one leaves you much room to think.</p>
      <a class="text-link" href="/about/">About Nikole <span class="arw">→</span></a>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section" style="display:grid; grid-template-columns:1fr 1.5fr; gap:80px; align-items:start">
    <div class="sticky-heading">
      <p class="eyebrow">Religious trauma</p>
      <h2 class="h2-serif">Frequently asked questions</h2>
      <Illustration name="questions-full" size="240px" class="mt-16" />
    </div>
    <Faq items={faqs} />
  </section>

  <!-- The bridge to faith-integrated therapy -->
  <section class="section sage on-color">
    <div class="col gap-20" style="max-width:760px">
      <p class="eyebrow on-color">A companion path</p>
      <h2 class="h2-serif">If faith is still the thing <em>that holds.</em></h2>
      <p class="body">Religion is rarely all one thing. Some of what you were given may have cost you and some of it may still be carrying you, and those can be true in the same person on the same Sunday.</p>
      <p class="body">If the sustaining part is the larger part right now, and what you are looking for is therapy that takes your spiritual life seriously rather than therapy about what went wrong in it, <a href="/services/faith-integrated-therapy/" style="color:var(--cream); border-bottom:1px solid var(--cream-35)">faith-integrated therapy</a> describes that work. It is the same practice and the same clinician. You do not need to have sorted out which page you belong on before you call, and most people do not arrive knowing.</p>
    </div>
  </section>

  <!-- Related reading -->
  <section class="section">
    <div class="stack gap-20" style="margin-bottom:36px">
      <p class="eyebrow">More on this</p>
      <h2 class="h2-serif">Related reading</h2>
    </div>
    <ul class="reading-list">
      {relatedReading.map((post) => (
        <li>
          <a href={post.href}><span>{post.title}</span><span class="arw" aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <NextSteps
    heading="Ready to stop carrying this alone? <em>Let’s talk.</em>"
    copy="The free 15-minute consultation is a conversation, not an intake. You can tell me as much or as little of the history as you want to. In-person in Newport Beach and Fullerton, or telehealth throughout California."
  />
</Layout>

<style>
  /* Related reading — two-column list of serif links on the cream background. */
  .reading-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 64px;
  }
  .reading-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--ink-25);
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.25;
    color: var(--ink);
  }
  .reading-list a:hover {
    opacity: 1;
    color: var(--blue);
  }
  @media (max-width: 760px) {
    .reading-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 820px) {
    section[style*='grid-template-columns:1fr 1.5fr'] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
  }
</style>
