62.051 405.967C178.234 415.752 198.664 421.5 224.356 421.5V420.75V420C198.894 420 178.742 414.306 162.827 404.684C146.912 395.061 135.19 381.483 126.632 365.65C109.502 333.958 105.07 293.278 105.07 257.417H104.32ZM419.997 208.955H419.247V291.75H419.997H420.747V208.955H419.997Z" fill="#3B63C4"/>
      <circle cx="25" cy="231.75" r="25" fill="#C7D64F"/>
