---
// A framed portrait slot. If `src` is provided it renders the image (with the
// signature sage duotone treatment); otherwise it shows a tasteful labelled
// placeholder so real photography can be dropped in later.
interface Props {
  placeholder: string;
  src?: string;
  alt?: string;
  tall?: boolean;
  caption?: string;
  class?: string;
  duotone?: boolean;
}
const {
  placeholder,
  src,
  alt = '',
  tall = false,
  caption,
  class: className,
  duotone = true,
} = Astro.props;
---

<div class={`portrait${tall ? ' tall' : ''}${className ? ` ${className}` : ''}`}>
  <div class="frame">
    {src ? (
      <>
        <img src={src} alt={alt} loading="lazy" class={duotone ? '' : 'no-duotone'} />
        {duotone && <div class="overlay"></div>}
      </>
    ) : (
      <div class="placeholder">{placeholder}</div>
    )}
  </div>
  {caption && <div class="caption" set:html={caption}></div>}
</div>
